# Heap for every node process npm launches (npm applies this OVER NODE_OPTIONS in the
# environment, so this file is the only place the build's heap can be set).
# Eleventy keeps every rendered page in memory; the full ~4,200-domain build needs
# ~10GB. Public-repo GitHub runners have 16GB. See _config/slim-html.js.
node-options=--max-old-space-size=14336
